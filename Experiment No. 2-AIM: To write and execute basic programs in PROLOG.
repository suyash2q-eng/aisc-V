Program 3: Factorial

factorial(0, 1).
factorial(N, Result) :-
    N > 0,
    N_minus_1 is N - 1,
    factorial(N_minus_1, SubResult),
    Result is N * SubResult.

?- factorial(5, F).


Program 4: Facts and rules (friends)

% Facts
likes(john, pizza).
likes(mary, pizza).
likes(rahul, burger).

% Rule
friends(X, Y) :-
    likes(X, pizza),
    likes(Y, pizza),
    X \= Y.

?- friends(john, mary).

